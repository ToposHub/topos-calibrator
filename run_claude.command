#!/bin/bash

#  ██████╗██╗      █████╗ ██╗    ██╗███████╗██████╗ 
# ██╔════╝██║     ██╔══██╗██║    ██║██╔════╝██╔══██╗
# ██║     ██║     ███████║██║ █╗ ██║█████╗  ██████╔╝
# ██║     ██║     ██╔══██║██║███╗██║██╔══╝  ██╔══██╗
# ╚██████╗███████╗██║  ██║╚███╔███╔╝███████╗██║  ██║
#  ╚═════╝╚══════╝╚═╝  ╚═╝ ╚══╝╚══╝ ╚══════╝╚═╝  ╚═╝

echo "🚀 正在启动 Claude Code (最高权限模式)..."
echo "💡 说明: 已跳过所有权限确认，自动执行所有操作。"
echo "💡 提示: 按 Ctrl+C 可随时中断程序。"
echo "────────────────────────────────────────"

# 1. 进入脚本所在目录
cd "$(dirname "$0")" || exit

# 2. 【关键修复】强制加载 Zsh 环境变量 (解决双击运行找不到 Key 的问题)
#    如果你是用 bash，请把 .zshrc 改成 .bash_profile
if [ -f "$HOME/.zshrc" ]; then
  source "$HOME/.zshrc"
fi

# 3. 运行 Claude (核心参数在这里！)
echo "🎮 开启最高权限模式，启动！"
echo "────────────────────────────────────────"
claude --dangerously-skip-permissions

# 4. 保持窗口打开 (防止报错后窗口瞬间关闭，让你看不见错误信息)
echo ""
echo "ℹ️  程序已退出。按回车键关闭窗口..."
read